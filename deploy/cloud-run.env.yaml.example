# Copy this file outside the repo or to a local ignored path before using it.
# Do not put secrets here; inject DATABASE_URL, SESSION_SECRET, and
# GOOGLE_CLIENT_SECRET from Secret Manager.
GOOGLE_CLIENT_ID: "replace-with-google-client-id"
GOOGLE_REDIRECT_URL: "https://SERVICE_URL/api/auth/google/callback"
BOOTSTRAP_ADMIN_EMAIL: "admin@example.com"
ADMIN_ALLOWED_ORIGINS: "https://SERVICE_URL"
APP_ALLOWED_ORIGINS: "https://app.example.com"
SECURE_COOKIES: "true"
